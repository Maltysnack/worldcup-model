# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data: too large for git, regenerated by `uv run worldcup-ingest`.
# Exclude everything in data/raw/ EXCEPT manual artifacts that CI
# cannot regenerate (FBref HTML pages + historical scorer CSV).
data/raw/*
!data/raw/fbref
data/raw/fbref/*
!data/raw/fbref/*.html
!data/raw/historical_wc_top_scorers.csv
!data/raw/historical_wc_top_scorers_seed.csv
data/*.duckdb
data/*.duckdb.wal

# Notebook checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
